Shader "Recovery/PenguinExpression"
{
    Properties
    {
        _MainTex ("Penguin", 2D) = "white" {}
        _Color ("Tint", Color) = (1,1,1,1)
        _EyeA ("Left eye", Vector) = (.54,.81,.035,.055)
        _EyeB ("Right eye", Vector) = (.7,.86,.03,.05)
        _Mouth ("Beak", Vector) = (.67,.75,.055,.026)
        _Blink ("Blink", Range(0,1)) = 0
        _Speak ("Open beak", Range(0,1)) = 0
    }
    SubShader
    {
        Tags { "Queue"="Transparent" "RenderType"="Transparent" "IgnoreProjector"="True" }
        Cull Off Lighting Off ZWrite Off Blend SrcAlpha OneMinusSrcAlpha
        Pass
        {
            CGPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "UnityCG.cginc"
            sampler2D _MainTex;
            fixed4 _Color;
            float4 _EyeA, _EyeB, _Mouth;
            float _Blink, _Speak;
            struct appdata { float4 vertex:POSITION; float2 uv:TEXCOORD0; fixed4 color:COLOR; };
            struct v2f { float4 vertex:SV_POSITION; float2 uv:TEXCOORD0; fixed4 color:COLOR; };
            v2f vert(appdata v) { v2f o; o.vertex=UnityObjectToClipPos(v.vertex);o.uv=v.uv;o.color=v.color*_Color;return o; }
            fixed4 Eye(fixed4 col, float2 uv, float4 eye)
            {
                if (_Blink<.01 || eye.z<.001) return col;
                float2 p=(uv-eye.xy)/max(eye.zw,float2(.001,.001));
                if (abs(p.x)>1.25 || abs(p.y)>1.15) return col;
                fixed4 cheek=tex2D(_MainTex,eye.xy+float2(-eye.z*1.35,0));
                fixed4 other=tex2D(_MainTex,eye.xy+float2(eye.z*1.35,0));
                if(other.r+other.g+other.b>cheek.r+cheek.g+cheek.b)cheek=other;
                float collapse=max(.06,1-_Blink);
                float2 sampleUV=float2(uv.x,eye.y+(uv.y-eye.y)/collapse);
                fixed4 eyeColor=tex2D(_MainTex,sampleUV);
                float band=saturate((collapse-abs(p.y))*22);
                col.rgb=lerp(cheek.rgb,eyeColor.rgb,band);
                return col;
            }
            fixed4 frag(v2f i):SV_Target
            {
                fixed4 col=tex2D(_MainTex,i.uv);
                col=Eye(Eye(col,i.uv,_EyeA),i.uv,_EyeB);
                if (_Speak>.01 && col.r>.55 && col.g>.16 && col.b<.3)
                {
                    float2 p=(i.uv-_Mouth.xy)/max(_Mouth.zw,float2(.001,.001));
                    float opening=1-smoothstep(.85,1.05,length(float2(p.x,p.y/max(.1,_Speak))));
                    col.rgb=lerp(col.rgb,fixed3(.06,.08,.13),opening);
                }
                return col*i.color;
            }
            ENDCG
        }
    }
}
