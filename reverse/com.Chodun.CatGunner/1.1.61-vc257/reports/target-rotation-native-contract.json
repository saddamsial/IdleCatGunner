  "nativeRules": {
    "creation": "Awake autoGenerate/isActive creates once; Start skips already generated; metadata has no OnEnable/OnDisable hooks. OnDestroy kills original tween.",
    "coordinate": "CreateTween animationType4 is DOLocalRotate; targetType11 Transform, mode0 Fast.",
    "change": "QuaternionPlugin Fast retains signed absolute differences <=180; only the original nonrelative rotation here is implemented. Actual source Euler is45,345,~0, not hint45,15,~0.",
    "evaluation": "linear scaled time, incremental infinite loops: startEuler + change * elapsed/duration. No callbacks or delay in this component.",
    "visibility": "existing Cat target owner changes position/active only; animation phase continues across target change and visibility. Local adapter lazily applies hidden progress when re-enabled instead of a global inactive-transform update."
  },
  "adapters": [
    "Runtime component and frame scheduler replace DOTween tween allocation/global manager; not full plugin lifecycle or all quaternion modes",
    "Original sprite, tilt, transform offsets/scale and existing compatibility material retained; disabled Shapes.Disc not enabled"
  ],
